--[[
    Animation Inspector — Matcha (fixed)
    - Safe LocalPlayer re-fetch (stops nil.LocalPlayer spam)
    - Sanitizes garbage track names from memory reads
    - Auto-picks common character folders (Live, Players, Entities, etc.)
    - pcall-wrapped target loop

    Controls: X retarget · C copy log · K clear
]]

local previous = _G.__MatchaAnimInspector
if previous and type(previous.stop) == "function" then
    pcall(previous.stop)
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local THIS_RUN = {}
_G.__MatchaAnimInspectorRun = THIS_RUN

local function getLP()
    local ok, lp = pcall(function()
        return Players.LocalPlayer
    end)
    if ok and lp then return lp end
    return nil
end

local function safeLoad(url, name)
    local ok, result = pcall(function()
        local src = httpget(url)
        if not src or src == "" then error("empty " .. url) end
        return loadstring(src, name)()
    end)
    if not ok then
        warn("[AnimInspector] load failed:", name, result)
        return nil
    end
    return result
end

local AnimationTracker = safeLoad(
    "https://raw.githubusercontent.com/artxficial/matchastuff/main/animationtracker.lua",
    "animationtracker"
) or _G.AnimationTracker

if not AnimationTracker then
    error("[AnimInspector] AnimationTracker required — script stopped")
end

local ESP_Utility = safeLoad(
    "https://raw.githubusercontent.com/artxficial/matchastuff/main/esp_utility.lua",
    "esp_utility"
) or _G.ESP_Utility

-- Patch ESP_Utility: original uses game.Players.LocalPlayer unguarded (Matcha nil spam + broken ESP)
if ESP_Utility then
    function ESP_Utility:_GetDistance()
        local lp = nil
        pcall(function() lp = game:GetService("Players").LocalPlayer end)
        if not lp then return 0 end
        local character = lp.Character
        if not character then return 0 end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return 0 end
        local ok, dist = pcall(function()
            local a, b = hrp.Position, self.Object.Position
            local dx, dy, dz = b.X - a.X, b.Y - a.Y, b.Z - a.Z
            return math.sqrt(dx * dx + dy * dy + dz * dz)
        end)
        return (ok and dist) or 0
    end
    -- Softer on-screen check: show if center is visible, not all 8 corners
    function ESP_Utility:_Get2D_Bounds()
        if not self.Object then return nil end
        local position = self.Object.Position
        local size = self.Object.Size
        local half = size * 0.5
        local minX, minY = math.huge, math.huge
        local maxX, maxY = -math.huge, -math.huge
        local anyOnScreen = false
        local corners = {
            Vector3.new(-1, -1, -1), Vector3.new(1, -1, -1),
            Vector3.new(1, -1, 1), Vector3.new(-1, -1, 1),
            Vector3.new(-1, 1, -1), Vector3.new(1, 1, -1),
            Vector3.new(1, 1, 1), Vector3.new(-1, 1, 1),
        }
        for i = 1, 8 do
            local o = corners[i]
            local worldPos = Vector3.new(
                position.X + o.X * half.X,
                position.Y + o.Y * half.Y,
                position.Z + o.Z * half.Z
            )
            local screenPos, onScreen = WorldToScreen(worldPos)
            if onScreen and screenPos then
                anyOnScreen = true
                if screenPos.X < minX then minX = screenPos.X end
                if screenPos.Y < minY then minY = screenPos.Y end
                if screenPos.X > maxX then maxX = screenPos.X end
                if screenPos.Y > maxY then maxY = screenPos.Y end
            end
        end
        if not anyOnScreen then
            -- fallback: center only
            local center, vis = WorldToScreen(position)
            if not vis or not center then return nil end
            local top, topVis = WorldToScreen(position + Vector3.new(0, half.Y, 0))
            local h = (topVis and top) and math.abs(center.Y - top.Y) * 4 or 40
            local w = h * 0.8
            return center.X - w * 0.5, center.Y - h * 0.5, center.X + w * 0.5, center.Y + h * 0.5
        end
        -- pad tiny boxes
        if maxX - minX < 20 then local c = (minX + maxX) * 0.5; minX, maxX = c - 10, c + 10 end
        if maxY - minY < 20 then local c = (minY + maxY) * 0.5; minY, maxY = c - 10, c + 10 end
        return minX, minY, maxX, maxY
    end
    
    function ESP_Utility:_IsAlive()
        if not self or not self.Object then return false end
        local obj = self.Object
        -- Matcha: game.Workspace can be nil; use workspace global / GetService
        local ws = workspace
        if not ws then
            pcall(function() ws = game:GetService("Workspace") end)
        end
        if not ws then return false end
        local ok, inside = pcall(function()
            return obj:IsDescendantOf(ws)
        end)
        return ok and inside == true
    end

    local _oldUpdate = ESP_Utility._Update
    function ESP_Utility:_Update()
        local ok, err = pcall(function()
            if not self or not self.Object then return end
            if not self:_IsAlive() then
                if self.Destroy then pcall(function() self:Destroy() end) end
                return
            end
            local min_x, min_y, max_x, max_y = self:_Get2D_Bounds()
            self.TrackerOffScreen = (min_x == nil)
            if not self:_DetermineVisibility() then return end
            if min_x == nil then return end
            local boxWidth = max_x - min_x
            self.Session = {
                CenterX = min_x + (boxWidth / 2),
                TopY = min_y,
            }
            if not self.Drawings or not self.Drawings["Square"] then return end
            local Square = self.Drawings["Square"].Drawing
            if Square then
                Square.Position = Vector2.new(min_x, min_y)
                Square.Size = Vector2.new(boxWidth, max_y - min_y)
            end
            if not self.DrawingOrder then return end
            for _, TextReference in ipairs(self.DrawingOrder) do
                local Data = self.Drawings[TextReference]
                if not Data then continue end
                local DrawingObject = Data.Drawing
                if not DrawingObject then continue end
                if Data.Function then
                    local ok2, result = pcall(Data.Function)
                    if ok2 and result ~= nil then
                        DrawingObject.Text = tostring(result)
                    end
                end
                if self._Position then
                    pcall(function() self:_Position(DrawingObject, Data.Y_Offset) end)
                end
            end
        end)
        -- swallow errors so one bad tracker doesn't spam
    end

    print("[AnimInspector] ESP_Utility patched (LocalPlayer-safe + softer bounds + alive/update)")
end

local cfg = {
    dead = false,
    selectedFolder = nil,
    maxRange = 120,
    autoNearest = true,
    trackSelf = true,
    trackOthers = true,
}

local IgnoreIds = {}
local Logged = {}
local LoggedOrder = {}
local TargetCharacters = {}
local EspTrackers = {}
local connections = {}
local Tracker = AnimationTracker.new(IgnoreIds)

local COLOR_WHITE = Color3.fromRGB(255, 255, 255)
local COLOR_GREEN = Color3.fromRGB(80, 220, 120)
local COLOR_YELLOW = Color3.fromRGB(255, 220, 80)

local KnownLabels = {
    ["rbxassetid://507770453"] = "Idle (default R15)",
    ["rbxassetid://507777826"] = "Walk (default R15)",
    ["rbxassetid://507767714"] = "Run (default R15)",
    ["rbxassetid://507765000"] = "Jump (default R15)",
    ["rbxassetid://507765644"] = "Fall (default R15)",
    ["rbxassetid://522638767"] = "Climb (default)",
    ["rbxassetid://507770239"] = "Swim (default)",
}

local function safeConnect(sig, fn)
    if not sig then return nil end
    local ok, c = pcall(function() return sig:Connect(fn) end)
    if ok and c then
        table.insert(connections, c)
        return c
    end
    return nil
end

local function sanitizeName(s)
    if type(s) ~= "string" then return nil end
    local cleaned = s:gsub("[^%w%_%-%.%/ ]", "")
    cleaned = cleaned:match("^%s*(.-)%s*$") or ""
    if #cleaned < 2 then return nil end
    if cleaned:match("^[%W%d%s]+$") and not cleaned:match("%a") then return nil end
    return cleaned
end

local function normalizeId(assetId)
    local id = tostring(assetId or "")
    if id == "" then return nil end
    if not id:find("rbxassetid://", 1, true) then
        local num = id:match("(%d+)")
        if num then id = "rbxassetid://" .. num end
    end
    return id
end

local function describeAnim(assetId, trackName)
    local id = normalizeId(assetId) or ""
    if KnownLabels[id] then return KnownLabels[id] end
    local n = string.lower(tostring(sanitizeName(trackName) or ""))
    if n == "" then return "Unknown action" end
    if n:find("slash") or n:find("swing") or n:find("attack") or n:find("punch")
        or n:find("kick") or n:find("stab") or n:find("m1") or n:find("lunge") then
        return "Likely attack / combat"
    end
    if n:find("idle") then return "Idle"
    elseif n:find("walk") then return "Walk"
    elseif n:find("run") then return "Run"
    elseif n:find("jump") then return "Jump"
    elseif n:find("fall") then return "Fall"
    elseif n:find("block") or n:find("parry") or n:find("guard") then return "Block / parry"
    elseif n:find("stun") or n:find("hit") or n:find("hurt") then return "Hit / stun reaction"
    end
    return "Unknown action"
end

local function displayNameFor(id, trackName)
    if KnownLabels[id] then return KnownLabels[id] end
    local clean = sanitizeName(trackName)
    if clean then return clean end
    local num = tostring(id):match("(%d+)")
    return num and ("Anim_" .. num:sub(-6)) or "Unknown"
end

local function logAnim(assetId, track)
    local id = normalizeId(assetId)
    if not id then return end
    local numeric = tonumber(id:match("%d+"))
    if numeric and table.find(IgnoreIds, numeric) then return end

    local name = displayNameFor(id, track and track.Name)
    local entry = Logged[id]
    if not entry then
        entry = {
            Name = name,
            Id = id,
            Time = track and track.TimePosition or 0,
            Speed = track and track.Speed or 1,
            Count = 1,
            Label = describeAnim(id, track and track.Name),
        }
        Logged[id] = entry
        table.insert(LoggedOrder, id)
    else
        entry.Count = entry.Count + 1
        entry.Time = (track and track.TimePosition) or entry.Time
        entry.Speed = (track and track.Speed) or entry.Speed
        local clean = sanitizeName(track and track.Name)
        if clean then
            entry.Name = clean
            entry.Label = describeAnim(id, clean)
        elseif KnownLabels[id] then
            entry.Name = KnownLabels[id]
            entry.Label = KnownLabels[id]
        end
    end
end

local function formatEntry(entry)
    return string.format(
        "[%s]  %s  |  %s  |  speed=%.2f  seen=%d",
        entry.Id,
        entry.Name or "?",
        entry.Label or "Unknown",
        entry.Speed or 1,
        entry.Count or 1
    )
end

local function copyLogged()
    if #LoggedOrder == 0 then
        print("[AnimInspector] Nothing logged yet")
        return
    end
    local lines = {
        "-- Animation Inspector export",
        string.format("-- PlaceId: %s  Game: %s", tostring(game.PlaceId), tostring(game.Name)),
        string.format("-- Count: %d", #LoggedOrder),
        "",
    }
    for _, id in ipairs(LoggedOrder) do
        local e = Logged[id]
        if e then
            table.insert(lines, formatEntry(e))
            table.insert(lines, string.format(
                '  ["%s"] = { DisplayName = "%s", Label = "%s" },',
                e.Id,
                (e.Name or "?"):gsub('"', "'"),
                (e.Label or "Unknown"):gsub('"', "'")
            ))
            table.insert(lines, "")
        end
    end
    setclipboard(table.concat(lines, "\n"))
    print("[AnimInspector] Copied", #LoggedOrder, "animations to clipboard")
    pcall(function()
        if notify then notify("Copied " .. #LoggedOrder .. " anims", "Anim Inspector", 3) end
    end)
end

local function clearLog()
    table.clear(Logged)
    table.clear(LoggedOrder)
    print("[AnimInspector] Log cleared")
end

local function foldersInWorkspace()
    local list = {}
    local ok, children = pcall(function() return Workspace:GetChildren() end)
    if not ok or type(children) ~= "table" then return list end
    for _, child in ipairs(children) do
        local cls = child.ClassName
        if cls == "Folder" or cls == "Model" then
            table.insert(list, child.Name)
        end
    end
    table.sort(list)
    return list
end

local function charactersInFolder()
    if not cfg.selectedFolder then return {} end
    local folder = Workspace:FindFirstChild(cfg.selectedFolder)
    if not folder then return {} end
    local out = {}
    local lp = getLP()
    local localChar = lp and lp.Character
    local ok, children = pcall(function() return folder:GetChildren() end)
    if not ok or type(children) ~= "table" then return out end
    for _, m in ipairs(children) do
        if m.ClassName == "Model" and m:FindFirstChildOfClass("Humanoid") then
            if not (localChar and m == localChar) then
                table.insert(out, m)
            end
        end
    end
    return out
end

local function clearEsp()
    for _, t in pairs(EspTrackers) do
        if t and t.Destroy then pcall(function() t:Destroy() end) end
    end
    table.clear(EspTrackers)
    table.clear(TargetCharacters)
end

local function setTargets(list)
    clearEsp()
    local lp = getLP()
    local localChar = lp and lp.Character
    for _, char in ipairs(list) do
        if not char then continue end
        table.insert(TargetCharacters, char)
        if ESP_Utility and char:FindFirstChild("HumanoidRootPart") then
            local isSelf = localChar and char == localChar
            local label = isSelf and ("YOU · " .. tostring(char.Name)) or tostring(char.Name)
            local color = isSelf and COLOR_YELLOW or COLOR_GREEN
            local ok, tr = pcall(function()
                return ESP_Utility.NewTracker(char.HumanoidRootPart, label, color)
            end)
            if ok and tr then
                pcall(function()
                    if tr.AddText then tr:AddText("Anims", nil, "...") end
                end)
                EspTrackers[char] = tr
            end
        end
    end
end

local function cycleTargets()
    pcall(function()
        local lp = getLP()
        local localChar = lp and lp.Character
        local root = localChar and localChar:FindFirstChild("HumanoidRootPart")
        local picks = {}

        if cfg.trackSelf and localChar and localChar:FindFirstChildOfClass("Humanoid") then
            table.insert(picks, localChar)
        end

        if cfg.trackOthers and root then
            local all = charactersInFolder()
            local scored = {}
            for _, char in ipairs(all) do
                if char ~= localChar then
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local d = (hrp.Position - root.Position).Magnitude
                        if d <= cfg.maxRange then
                            table.insert(scored, { char = char, d = d })
                        end
                    end
                end
            end
            table.sort(scored, function(a, b) return a.d < b.d end)
            for i = 1, math.min(5, #scored) do
                table.insert(picks, scored[i].char)
            end
        end

        setTargets(picks)
    end)
end

local function updateTargets()
    pcall(function()
        for i = #TargetCharacters, 1, -1 do
            local char = TargetCharacters[i]
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local tracker = EspTrackers[char]

            if not char or not char.Parent or not hum or not hrp then
                if tracker and tracker.Destroy then pcall(function() tracker:Destroy() end) end
                EspTrackers[char] = nil
                table.remove(TargetCharacters, i)
                continue
            end

            local okUpd, anims = pcall(function() return Tracker:Update(char) end)
            anims = (okUpd and anims) or {}

            local lines = {}
            if #anims == 0 then
                table.insert(lines, "None playing")
            else
                for _, anim in ipairs(anims) do
                    if not anim.AnimationId then continue end
                    local id = normalizeId(anim.AnimationId)
                    if not id then continue end
                    local name = displayNameFor(id, anim.Name)
                    local label = describeAnim(id, anim.Name)
                    logAnim(id, anim)
                    table.insert(lines, string.format(
                        "%s\n  %s\n  %s | t=%.2f spd=%.2f",
                        name,
                        label,
                        id,
                        anim.TimePosition or 0,
                        anim.Speed or 1
                    ))
                end
            end

            if tracker and tracker.ChangeText then
                pcall(function()
                    tracker:ChangeText("Anims", table.concat(lines, "\n\n"), COLOR_WHITE)
                    tracker:ChangeText("Name", string.format("%s [%d logged]", char.Name, #LoggedOrder), COLOR_GREEN)
                end)
            end
        end
    end)
end

local function buildUI()
    if not UI or not UI.AddTab then
        print("[AnimInspector] Matcha UI global missing — hotkeys still work")
        return
    end
    pcall(function() UI.RemoveTab("AnimInspect") end)

    UI.AddTab("AnimInspect", function(tab)
        if cfg.dead then return end
        local left = tab:Section("Targets", "Left")
        left:Toggle("ai_self", "Track myself", cfg.trackSelf, function(on)
            cfg.trackSelf = on and true or false
            cycleTargets()
        end)
        left:Toggle("ai_others", "Track others nearby", cfg.trackOthers, function(on)
            cfg.trackOthers = on and true or false
            cycleTargets()
        end)
        left:Toggle("ai_auto", "Auto refresh targets", cfg.autoNearest, function(on)
            cfg.autoNearest = on and true or false
        end)
        left:SliderInt("ai_range", "Others max range", 10, 300, cfg.maxRange, function(v)
            cfg.maxRange = v
        end)

        local folders = foldersInWorkspace()
        left:Combo("ai_folder", "Folder", folders, 0, function(idx, text)
            cfg.selectedFolder = text
            cycleTargets()
        end)

        local preferred = { "Live", "Players", "Characters", "Entities", "Mobs", "NPCs", "Units", "Fighters" }
        for _, want in ipairs(preferred) do
            for _, name in ipairs(folders) do
                if name == want then
                    cfg.selectedFolder = name
                    break
                end
            end
            if cfg.selectedFolder then break end
        end
        if not cfg.selectedFolder and #folders > 0 then
            cfg.selectedFolder = folders[1]
        end

        left:Button("Refresh targets (X)", function() cycleTargets() end)

        local right = tab:Section("Log", "Right")
        right:Button("Copy log to clipboard (C)", function() copyLogged() end)
        right:Button("Clear log (K)", function() clearLog() end)
        right:Text("Garbage track names from memory are auto-cleaned.")
        right:Text("Add known ids to KnownLabels at the top of the script if you want custom names.")
    end)
end

local VK = { X = 0x58, C = 0x43, K = 0x4B }
local last = { x = false, c = false, k = false }

local function pollHotkeys()
    if type(iskeypressed) ~= "function" then return end
    local x = iskeypressed(VK.X)
    local c = iskeypressed(VK.C)
    local k = iskeypressed(VK.K)
    if x and not last.x then cycleTargets() end
    if c and not last.c then copyLogged() end
    if k and not last.k then clearLog() end
    last.x, last.c, last.k = x, c, k
end

safeConnect(UIS and UIS.InputBegan, function(input, gp)
    if gp then return end
    local code = input and input.KeyCode
    if code == Enum.KeyCode.X then cycleTargets()
    elseif code == Enum.KeyCode.C then copyLogged()
    elseif code == Enum.KeyCode.K then clearLog()
    end
end)

local lastCycle = 0
local lastErrorPrint = 0

local function stop()
    if cfg.dead then return end
    cfg.dead = true
    clearEsp()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    connections = {}
    pcall(function() if UI and UI.RemoveTab then UI.RemoveTab("AnimInspect") end end)
    if _G.__MatchaAnimInspectorRun == THIS_RUN then
        _G.__MatchaAnimInspectorRun = nil
    end
    _G.__MatchaAnimInspector = nil
end

_G.__MatchaAnimInspector = { stop = stop, run = THIS_RUN }

local stepped = RunService and (RunService.RenderStepped or RunService.Heartbeat)
safeConnect(stepped, function()
    if cfg.dead or _G.__MatchaAnimInspectorRun ~= THIS_RUN then return end
    local ok, err = pcall(function()
        pollHotkeys()
        local now = os.clock()
        if cfg.autoNearest and (now - lastCycle) > 1.0 then
            lastCycle = now
            cycleTargets()
        end
        updateTargets()
    end)
    if not ok then
        local t = os.clock()
        if t - lastErrorPrint > 5 then
            lastErrorPrint = t
            warn("[AnimInspector] loop error:", tostring(err))
        end
    end
end)

pcall(buildUI)
pcall(cycleTargets)

print("[AnimInspector] Loaded (fixed) — X retarget · C copy · K clear")
pcall(function()
    if notify then notify("Anim Inspector fixed", "LocalPlayer-safe + clean names", 4) end
end)
